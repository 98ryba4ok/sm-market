# Domain (prod only)
DOMAIN=example.com
CERTBOT_EMAIL=your@email.com

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=sm-santex.ru,www.sm-santex.ru

# Database
POSTGRES_DB=sm_market
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend
VITE_API_URL=/api
FRONTEND_URL=http://localhost:5173

# Email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sm-market.com

# ЮКасса (Yookassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_ENABLED=false
YOOKASSA_RETURN_URL=http://localhost:5173/payment/return
# Код ставки НДС для чеков 54-ФЗ: 11 = НДС 22%, 12 = НДС 22/122, 1 = без НДС
YOOKASSA_VAT_CODE=11

# Telegram-уведомления о заказах (новый заказ / оплата)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
